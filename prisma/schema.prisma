generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senha     String
  createdAt DateTime  @default(now())
  produtos  Product[]
}

model Product {
  id        Int      @id @default(autoincrement())
  nome      String
  preco     Float
  descricao String
  estado    String
  imagem    String?
  createdAt DateTime @default(now())
  userId    Int
  usuario   User     @relation(fields: [userId], references: [id])
}
